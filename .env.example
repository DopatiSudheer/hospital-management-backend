# Server Configuration
SERVER_PORT=8080

# TiDB Cloud Database Configuration
# Format: jdbc:mysql://<host>:<port>/<database>?sslMode=VERIFY_IDENTITY
DATABASE_URL=jdbc:mysql://gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/hospital?sslMode=VERIFY_IDENTITY
DATABASE_USERNAME=your_tidb_username
DATABASE_PASSWORD=your_tidb_password

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# Admin Configuration
ADMIN_EMAIL=admin@hospital.com
ADMIN_PASSWORD=your_secure_password
ADMIN_NAME=System Administrator
